{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentpeerchat",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentpeerchat",
      "database_id": "dbc631bf-a678-4af9-907c-6fbf8d9a4049",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFICATIONS",
        "class_name": "MailboxHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "mailbox-notifications-v1",
      "new_sqlite_classes": [
        "MailboxHub"
      ]
    }
  ]
}
